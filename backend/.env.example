# Environment template file for backend
# Duplicate as .env and update values for your environment

# Environment
ENVIRONMENT=development

# FastAPI Settings
DEBUG=True
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Model Settings
MODEL_PATH=models/best_model.pth
MODEL_TYPE=pytorch
MODEL_VARIANT=clahe
MODEL_WARMUP=true

# Image Settings
MAX_IMAGE_SIZE=10485760  # 10 MB in bytes
MAX_BATCH_SIZE=10
SUPPORTED_FORMATS=jpg,jpeg,png

# Preprocessing
IMAGE_WIDTH=256
IMAGE_HEIGHT=256
IMAGE_CHANNELS=3
NORMALIZATION_MEAN=0.5
NORMALIZATION_STD=0.5

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# Logging
LOG_FILE=logs/app.log

# Database (optional)
DATABASE_URL=sqlite:///./app.db

# Security (for production)
SECRET_KEY=your-secret-key-here
API_KEY=optional-api-key

# Monitoring (optional)
SENTRY_DSN=

# Performance
ENABLE_CACHING=false
CACHE_TTL=300
